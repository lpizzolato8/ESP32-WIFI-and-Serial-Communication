[submodule "stm32/lib/cmsis-device-f4"]
	path = stm32/lib/cmsis-device-f4
	url = https://github.com/STMicroelectronics/cmsis-device-f4.git
	shallow = true
[submodule "stm32/lib/stm32f4xx-hal-driver"]
	path = stm32/lib/stm32f4xx-hal-driver
	url = https://github.com/STMicroelectronics/stm32f4xx-hal-driver.git
	shallow = true
[submodule "stm32/lib/cmsis-core"]
	path = stm32/lib/cmsis-core
	url = https://github.com/STMicroelectronics/cmsis-core.git
	shallow = true
